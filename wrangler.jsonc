{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leetzone",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",

  // The site. Everything under /api/ goes to the Worker; any other path that is
  // not a file falls back to index.html so the client-side router can take it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Lobby object per lobby code: live state, timers, WebSockets.
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],

  // Long-term stats. Locally this is a SQLite file under .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leetzone",
      "database_id": "2cd05933-f57a-47f9-a178-c1570b81ea8b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Players needed before the host can start. Set to "1" in .dev.vars to play alone.
    "MIN_PLAYERS": "2"
  },
  // Secret, set with `wrangler secret put INVITE_CODE`. Unset means no invite gate.
  // INVITE_CODE

  "routes": [{ "pattern": "leetzone.adityagrawal.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true }
}
